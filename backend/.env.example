# --- SyncSpace backend environment ---
# Copy to .env and fill in real values:  cp .env.example .env

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/syncspace

# Secret used to sign/verify JWTs — use a long random string in production
JWT_SECRET=replace-with-a-long-random-secret

# Port the Express/Socket.IO server listens on
PORT=5000

# Origin of the Vite frontend, used for CORS + Socket.IO
CLIENT_URL=http://localhost:5173

# Code execution (Piston). The public instance at emkc.org went offline on
# 31 Aug 2026 and now answers 401, so point this at a self-hosted runner.
# Full setup — Docker, WSL2, installing runtimes: docs/PISTON_SETUP.md
# Base URL only; the service appends /api/v2/execute (a full endpoint URL also
# works — it is normalised either way).
PISTON_URL=http://localhost:2000

# The runner needs 4 packages to cover all 5 editor languages — gcc provides
# both C and C++:  node 20.11.1, python 3.12.0, gcc 10.2.0, java 15.0.2
# Versions are not pinned in code (LANGUAGE_MAP asks for "*"), but the language
# must be installed or execution answers "<language>-* runtime is unknown".

# How long to wait for a run before giving up (default 15000).
# Raise it if cold-start C/C++/Java compiles are hitting the limit.
# PISTON_TIMEOUT_MS=15000
